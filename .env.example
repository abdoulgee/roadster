# Copy to .env.local and fill in to turn on the online leaderboard.
# Both values are in Supabase → Project Settings → API. The anon key is public by design:
# the tables are locked down and only reachable through the functions in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Anonymous visit analytics power /admin.html. They post to /api/track and are stored in Vercel
# Blob, so no client key is needed. Set this to 1 to stop them (and the IP location lookup).
# VITE_ANALYTICS_OFF=1

# Server-only (set these in Vercel → Project Settings → Environment Variables, not in this file):
# BLOB_READ_WRITE_TOKEN  Added automatically when a Vercel Blob store is connected
# BLOB_ACCESS            Set to "private" when your Blob store is private (default: public)
# ADMIN_PASSWORD         Pit-wall password (api/admin.js falls back to "qwertyuiop")
